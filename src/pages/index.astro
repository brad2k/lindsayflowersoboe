---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

export const prerender = true;

const [page] = await getCollection("home");
const { pageTitle, pageDescription, eyebrow, heading } = page.data;
// const concerts = (await getCollection("concerts")).sort(
//   (a, b) => a.data.date.valueOf() - b.data.date.valueOf()
// );
---

<Layout title={pageTitle}>
  <div>
    <p>{eyebrow}</p>
    <h1>{heading}</h1>
    <p>{pageDescription}</p>
  </div>
</Layout>
