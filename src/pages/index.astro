---
import { Image } from "astro:assets";
import { getEntry } from "astro:content";
import Button from "../components/Button.astro";
import Heading from "../components/Heading.astro";
import PhotoCredit from "../components/PhotoCredit.astro";
import HeroImage from "../images/lindsay-flowers-home.png";
import Layout from "../layouts/Layout.astro";
import HeroLayout from "../layouts/HeroLayout.astro";
import HeroBlock from "../components/HeroBlock.astro";

const page = await getEntry("home", "index");
if (!page) throw new Error("Missing home content");
const {
  pageTitle,
  pageDescription,
  eyebrow,
  heading,
  heroSummary,
  photoCredit,
} = page.data;
// const concerts = (await getCollection("concerts")).sort(
//   (a, b) => a.data.date.valueOf() - b.data.date.valueOf()
// );
---

<Layout title={pageTitle} description={pageDescription} wrapperClass="stack">
  <HeroLayout>
    <HeroBlock slot="hero">
      <p class="eyebrow">{eyebrow}</p>
      <Heading as="h1" variant={"large"}>{heading}</Heading>
      <p>{heroSummary}</p>
      <Button href="/bio/">View bio</Button>
      <Button href="/media/">Explore media →</Button>
    </HeroBlock>

    <figure slot="figure">
      <Image src={HeroImage} alt="Lindsay Flowers holding an oboe" priority />
      <PhotoCredit credit={photoCredit} />
    </figure>
  </HeroLayout>
</Layout>

<style>
  .page-wrapper {
    container-type: inline-size;

    @container (width > 36.66rem) {
      & > figure {
        order: 1;
      }
    }
  }
</style>
