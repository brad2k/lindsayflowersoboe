---
import { Image } from "astro:assets";
import { getEntry, render } from "astro:content";
import Heading from "../components/Heading.astro";
import PhotoCredit from "../components/PhotoCredit.astro";
import HeroImage from "../images/lindsay-flowers-bio.png";
import Layout from "../layouts/Layout.astro";
import HeroLayout from "../layouts/HeroLayout.astro";
import HeroBlock from "../components/HeroBlock.astro";

const page = await getEntry("bio", "index");
if (!page) throw new Error("Missing bio content");
const {
  pageTitle,
  pageDescription,
  eyebrow,
  heading,
  heroSummary,
  photoCredit,
} = page.data;
const { Content } = await render(page);
---

<Layout title={pageTitle} description={pageDescription} wrapperClass="stack">
  <HeroLayout>
    <figure slot="figure">
      <Image src={HeroImage} alt="Lindsay Flowers holding two oboes" priority />
      <PhotoCredit credit={photoCredit} />
    </figure>

    <HeroBlock slot="hero">
      <h1 class="eyebrow">{eyebrow}</h1>
      <Heading as="h2" variant={"large"}>{heading}</Heading>
      <p>{heroSummary}</p>
    </HeroBlock>
  </HeroLayout>

  <Content />
</Layout>
