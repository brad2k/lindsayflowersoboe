---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import Heading from "../components/Heading.astro";
import PhotoCredit from "../components/PhotoCredit.astro";
import HeroImage from "../images/lindsay-flowers-bio.png";
import Layout from "../layouts/Layout.astro";
import PageLayout from "../layouts/PageLayout.astro";

const [page] = await getCollection("bio");
const {
  pageTitle,
  pageDescription,
  eyebrow,
  heading,
  heroSummary,
  photoCredit,
} = page.data;
const { Content } = await render(page);
---

<Layout title={pageTitle} description={pageDescription} wrapperClass="stack">
  <PageLayout>
    <figure slot="figure">
      <Image src={HeroImage} alt="Lindsay Flowers holding two oboes" priority />
      <PhotoCredit credit={photoCredit} />
    </figure>

    <div class="stack hero-text" slot="hero">
      <h1 class="eyebrow">{eyebrow}</h1>
      <Heading as="h2" variant={"large"}>{heading}</Heading>
      <p>{heroSummary}</p>
    </div>
  </PageLayout>

  <Content />
</Layout>

<style>
  .hero-text {
    --fc-stack-space: var(--fc-space-m);
    justify-content: center;
  }
</style>
