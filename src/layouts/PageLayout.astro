---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"section">;

const { class: className, ...rest } = Astro.props;
---

<section {...rest} class:list={["page-wrapper", "auto-grid", className]}>
  <slot name="figure" />
  <slot name="hero" />
  <slot />
</section>

<style>
  .page-wrapper {
    --fc-grid-space: var(--fc-space-2xl);
  }
</style>
