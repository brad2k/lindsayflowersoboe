---
import type { HTMLTag, Polymorphic } from "astro/types";
import Heading from "./Heading.astro";

type Props<Component extends HTMLTag> = Polymorphic<{
  as: Component;
  note?: boolean;
}>;

const {
  as: Component = "div",
  children,
  class: className,
  note = false,
  ...rest
} = Astro.props;
---

<Component {...rest} class:list={["card-header", className]}>
  {
    note && (
      <div class="note" aria-hidden>
        ♪
      </div>
    )
  }
  <Heading as="h3" variant="small"><slot /></Heading>
</Component>

<style>
  .note {
    text-align: center;
    font-size: var(--font-size-l);
    margin-bottom: 1em;
    color: var(--color-text-accent);
  }
</style>
