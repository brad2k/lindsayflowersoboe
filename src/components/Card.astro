---
import type { HTMLTag, Polymorphic } from "astro/types";

type Props<Component extends HTMLTag> = Polymorphic<{
  as: Component;
}>;

const {
  as: Component = "div",
  children,
  class: className,
  ...rest
} = Astro.props;
---

<Component {...rest} class:list={["card", className]}><slot /></Component>

<style>
  .card {
    --card-padding: var(--space-sm);
    --card-font-size: var(--fc-step--1);
    --card-border-color: var(--color-border-border);
    --card-color-bg: transparent;

    display: grid;
    grid-row: span 2;
    grid-template-rows: subgrid;
    gap: var(--space-2xs);
    text-align: var(--card-text-alignment, left);
    padding: var(--card-padding);
    background-color: var(--card-color-bg);
    font-size: var(--card-font-size);
    border: 1px solid var(--card-border-color);
  }
</style>
