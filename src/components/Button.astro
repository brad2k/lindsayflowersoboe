---
import type { HTMLAttributes } from "astro/types";

type ButtonVariants = "primary" | "ghost";

type Props =
  | ({ href: string; variant?: ButtonVariants } & HTMLAttributes<"a">)
  | ({ href?: never; variant?: ButtonVariants } & HTMLAttributes<"button">);

const { class: className, href, variant = "primary", ...props } = Astro.props;
---

{
  href ? (
    <a
      {...(props as HTMLAttributes<"a">)}
      class:list={["button", className]}
      href={href}
      data-variant={variant}
    >
      <slot />
    </a>
  ) : (
    <button
      {...(props as HTMLAttributes<"button">)}
      class:list={["button", className]}
      type="button"
      data-variant={variant}
    >
      <slot />
    </button>
  )
}

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--fc-space-2xs);
    padding: var(--fc-space-xs) var(--fc-space-s);
    border: 0;
    background-color: var(--color-button-primary-bg);
    color: var(--color-button-primary-text);
    font-family: var(--font-body);
    font-weight: var(--fc-font-weight-semi-bold);
    font-size: var(--fc-step--1);
    text-decoration: none;
    cursor: pointer;
    transition: background-color var(--fc-animation-transition-snappy);
    width: fit-content;

    @media (prefers-reduced-motion: reduce) {
      transition: none;
    }

    @media (hover: hover) {
      &:hover {
        background-color: var(--color-button-primary-bg-hover);
      }
    }

    &:focus-visible {
      outline: 2px solid var(--color-button-primary-bg);
      outline-offset: 2px;
    }

    &[data-variant="ghost"] {
      background-color: transparent;
      color: var(--color-text-link);
    }
  }
</style>
